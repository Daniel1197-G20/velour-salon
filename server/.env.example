# Firebase / Firestore Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Path or JSON string for Firebase Service Account Key
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Optional: If testing against Firestore emulator locally
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ----------------------------------------------------
# Email Notifications (Choose ANY 1 of these 4 methods)
# ----------------------------------------------------
# Method 1 (BEST FREE NO-DOMAIN OPTION): Brevo (Sendinblue)
# 1. Sign up free at https://brevo.com (300 free emails/day to ANY recipient)
# 2. Get API key from Profile -> SMTP & API
# 3. Enter key below (NO custom domain or Google App Password required!):
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=your-email@gmail.com

# Method 2: Resend API (Requires a custom domain at https://resend.com/domains for external recipients)
RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=Velour Hairs & Beauty <bookings@yourdomain.com>

# Method 3: Generic SMTP (Brevo SMTP, Mailjet, Outlook, Hostinger, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-login-email@gmail.com
# SMTP_PASS=your-smtp-master-password

# Method 4: Gmail SMTP with 16-character App Password (https://myaccount.google.com/apppasswords)
# EMAIL_USER=your-salon-email@gmail.com
# EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Salon owner/admin notification email (receives new booking & order alerts)
ADMIN_NOTIFICATION_EMAIL=your-salon-email@gmail.com
